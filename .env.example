# ------------------------------------------------------------------
# Run With Nicole — environment variables
# Copy to .env for local work. On Netlify: Site configuration →
# Environment variables. See README.md.
# Values starting with "your-" are placeholders and will stop the build.
# ------------------------------------------------------------------

# sanity.io/manage → your project → Project ID
NEXT_PUBLIC_STUDIO_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# sanity.io/manage → API → Tokens → Add token → "Viewer"
# Used by the build scripts to read published content (server-side only)
SANITY_API_READ_TOKEN=your-sanity-viewer-token

# Local: http://localhost:3000 — Netlify: the site URL / custom domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Netlify only — sanity.io/manage → API → Tokens → Add token → "Deploy studio"
# Lets the Netlify build redeploy the Studio (runwithnicole.sanity.studio)
SANITY_AUTH_TOKEN=your-sanity-deploy-token
